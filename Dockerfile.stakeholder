FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY dashboards/requirements.txt ./requirements-dashboard.txt
RUN python -m pip install --upgrade pip \
    && pip install -r requirements-dashboard.txt

COPY dashboards ./dashboards
COPY src ./src
COPY models ./models
COPY reports ./reports

EXPOSE 8501

CMD ["streamlit", "run", "dashboards/streamlit_app.py", "--server.address=0.0.0.0", "--server.port=8501"]
